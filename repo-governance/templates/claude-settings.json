{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/checks/check-source-writes.sh\" --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/checks/check-file-length.sh\" --hook",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "David-Colson/claude-plugin-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "repo-governance@claude-plugin-marketplace": true
  }
}
